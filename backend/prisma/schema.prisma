// Auth models (stage 3). Catalog models (stage 2 / #4).
// See docs/superpowers/specs/2026-07-21-auth-roles-permissions-design.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  checkedAt DateTime @default(now())
}

enum OrderType {
  purchase
  request_products
}

enum OrderStatus {
  pending
  processing
  shipped
  completed
  cancelled
}

enum PaymentStatus {
  pending_manual
  paid_manual
  not_required
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  name          String
  passwordHash  String
  phone         String?
  company       String?
  inn           String?
  position      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  roles         UserRole[]
  refreshTokens RefreshToken[]
  cart          Cart?
  orders        Order[]
}

model Role {
  id          Int        @id @default(autoincrement())
  slug        String     @unique
  name        String
  permissions String[]
  isSystem    Boolean    @default(false)
  users       UserRole[]
}

model UserRole {
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Manufacturer {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  name        String
  isPublished Boolean   @default(true)
  deletedAt   DateTime?
  products    Product[]
}

model Category {
  id             Int        @id @default(autoincrement())
  slug           String     @unique
  name           String
  description    String?
  seoTitle       String?
  seoDescription String?
  parentId       Int?
  isPublished    Boolean    @default(true)
  deletedAt      DateTime?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryTree")
  products       Product[]
  photos         Photo[]
  documents      Document[]
}

model Product {
  id             Int          @id @default(autoincrement())
  slug           String       @unique
  title          String
  sku            String       @unique
  description    String
  specs          Json
  badges         String[]
  similarSlugs   String[]
  price          Decimal?     @db.Decimal(10, 2)
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean      @default(true)
  deletedAt      DateTime?
  manufacturerId Int
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  categoryId     Int
  category       Category     @relation(fields: [categoryId], references: [id])
  photos         Photo[]
  documents      Document[]
  cartItems      CartItem[]
  orderLines     OrderLine[]
}

model Cart {
  id             Int        @id @default(autoincrement())
  guestSessionId String?    @unique
  userId         Int?       @unique
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CartItem[]
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Order {
  id             Int           @id @default(autoincrement())
  userId         Int
  type           OrderType
  status         OrderStatus   @default(pending)
  paymentStatus  PaymentStatus
  customerName   String
  customerEmail  String
  customerPhone  String?
  customerCompany String?
  customerInn    String?
  customerPosition String?
  customerNote   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id])
  lines          OrderLine[]
}

model OrderLine {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Decimal? @db.Decimal(10, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
}

model NewsArticle {
  id             Int       @id @default(autoincrement())
  slug           String    @unique
  title          String
  excerpt        String
  body           String[]
  publishDate    DateTime  @db.Date
  published      Boolean   @default(true)
  seoTitle       String?
  seoDescription String?
  deletedAt      DateTime?
  photos         Photo[]
  documents      Document[]
}

model Photo {
  id            Int          @id @default(autoincrement())
  sortOrder     Int          @default(0)
  filename      String
  storedName    String       @unique
  mimeType      String
  sizeBytes     Int
  productId     Int?
  newsArticleId Int?
  categoryId    Int?
  product       Product?     @relation(fields: [productId], references: [id])
  newsArticle   NewsArticle? @relation(fields: [newsArticleId], references: [id])
  category      Category?    @relation(fields: [categoryId], references: [id])

  @@index([productId, sortOrder])
  @@index([newsArticleId])
  @@index([categoryId])
}

model Document {
  id            Int          @id @default(autoincrement())
  sortOrder     Int          @default(0)
  filename      String
  storedName    String       @unique
  mimeType      String
  sizeBytes     Int
  productId     Int?
  newsArticleId Int?
  categoryId    Int?
  product       Product?     @relation(fields: [productId], references: [id])
  newsArticle   NewsArticle? @relation(fields: [newsArticleId], references: [id])
  category      Category?    @relation(fields: [categoryId], references: [id])

  @@index([productId, sortOrder])
  @@index([newsArticleId])
  @@index([categoryId])
}
