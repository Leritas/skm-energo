// Auth models (stage 3). Catalog models (stage 2 / #4).
// See docs/superpowers/specs/2026-07-21-auth-roles-permissions-design.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  checkedAt DateTime @default(now())
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  name          String
  passwordHash  String
  phone         String?
  company       String?
  inn           String?
  position      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  roles         UserRole[]
  refreshTokens RefreshToken[]
}

model Role {
  id          Int        @id @default(autoincrement())
  slug        String     @unique
  name        String
  permissions String[]
  isSystem    Boolean    @default(false)
  users       UserRole[]
}

model UserRole {
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Manufacturer {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  name     String
  products Product[]
}

model Category {
  id          Int        @id @default(autoincrement())
  slug        String     @unique
  name        String
  description String?
  parentId    Int?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
}

model Product {
  id             Int          @id @default(autoincrement())
  slug           String       @unique
  title          String
  sku            String       @unique
  description    String
  specs          Json
  pdfHref        String?
  badges         String[]
  similarSlugs   String[]
  manufacturerId Int
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  categoryId     Int
  category       Category     @relation(fields: [categoryId], references: [id])
}

model NewsArticle {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  excerpt     String
  body        String[]
  publishDate DateTime @db.Date
}
